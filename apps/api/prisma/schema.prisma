// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  modifiedAt   DateTime @updatedAt

  products Product[]
  roles    UserRole[]
}

model UserRole {
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

enum Currency {
  BRL
  USD
  EUR
  CAD
}

enum ProductCapabilityType {
  PAY_PIX
  PAY_CARD
  PAY_CRYPTO
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sellerId    String
  description String?
  priceCents  Int
  currency    Currency @default(BRL)

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capabilities ProductCapability[]

  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  checkoutLinks CheckoutLink[]

  @@index([sellerId])
  @@index([sellerId, isArchived])
}

model ProductCapability {
  id        String                @id @default(uuid())
  productId String
  type      ProductCapabilityType
  enabled   Boolean               @default(true)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type])
  @@index([productId])
}

model CheckoutLink {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  slugUrl String @unique

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  checkoutSessions CheckoutSession[]

  @@index([productId])
  @@index([isActive])
  @@index([expiresAt])
}

model CheckoutSession {
  id String @id @default(cuid())

  checkoutLinkId String
  checkoutLink   CheckoutLink @relation(fields: [checkoutLinkId], references: [id], onDelete: Cascade)

  status CheckoutSessionStatus @default(CREATED)

  customerName  String?
  customerEmail String?
  customerPhone String?

  selectedMethod PaymentMethod?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payment   Payment?

  @@index([checkoutLinkId])
  @@index([customerEmail])
}

enum CheckoutSessionStatus {
  CREATED
  CUSTOMER_SET
  PAYMENT_SELECTED
  EXPIRED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  CRYPTO
}

model Payment {
  id        String          @id @default(uuid())
  sessionId String          @unique
  session   CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider

  //snapshot of moment value
  amountCents Int
  currency    Currency @default(BRL)

  //provider id 
  providerPaymentId String? @unique

  //payment methods
  pix PixPayment?
  //card CardPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PixPayment {
  paymentId String  @id
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  //payload pix
  copyPaste String
  qrCode    String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentProvider {
  MERCADO_PAGO
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}
