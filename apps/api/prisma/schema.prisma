// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  modifiedAt   DateTime @updatedAt

  products Product[]
  roles    UserRole[]
}

model UserRole {
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

enum Currency {
  BRL
  USD
  EUR
  CAD
}

enum ProductCapabilityType {
  PAY_PIX
  PAY_CARD
  PAY_CRYPTO
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sellerId    String
  description String?
  priceCents  Int
  currency    Currency @default(BRL)

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capabilities ProductCapability[]

  seller         User            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  checkoutLinks  CheckoutLink[]
  checkoutEvents CheckoutEvent[]

  @@index([sellerId])
  @@index([sellerId, isArchived])
}

model ProductCapability {
  id        String                @id @default(uuid())
  productId String
  type      ProductCapabilityType
  enabled   Boolean               @default(true)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type])
  @@index([productId])
}

model CheckoutLink {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  slugUrl String @unique

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  checkoutEvents CheckoutEvent[]

  @@index([productId])
  @@index([isActive])
  @@index([expiresAt])
}

// ------ FOR ANALYTICS ------
enum CheckoutEventType {
  CHECKOUT_VIEW
  CHECKOUT_BLOCKED
  PAYMENT_METHOD_SELECTED
}

enum CheckoutBlockedReason {
  LINK_NOT_FOUND
  LINK_DISABLED
  LINK_EXPIRED
  PRODUCT_ARCHIVED
}

enum PaymentMethodType {
  PAY_PIX
  PAY_CARD
  PAY_CRYPTO
}

model CheckoutEvent {
  id String @id @default(uuid())

  checkoutLinkId String
  checkoutLink   CheckoutLink @relation(fields: [checkoutLinkId], references: [id], onDelete: Cascade)

  // redundante, mas acelera analytics por produto sem join pesado
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type CheckoutEventType

  // campos opcionais por tipo
  blockedReason CheckoutBlockedReason?
  paymentMethod PaymentMethodType?

  // metadata geral pra evoluir sem migração (utm, device, extra)
  metadata Json?

  // privacidade
  ipHash    String?
  userAgent String?
  referrer  String?

  createdAt DateTime @default(now())

  @@index([checkoutLinkId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

// ------ FINISH FOR ANALYTICS ------
